{
  "manifest_version": 3,
  "name": "DNC Watchdog USPS Helper",
  "version": "1.0.3",
  "description": "Sends USPS tracking status from your real browser to the local DNC Watchdog app.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:4000/*",
    "http://localhost:4000/*",
    "https://tools.usps.com/*",
    "https://www.usps.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://tools.usps.com/*",
        "https://www.usps.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:4000/*",
        "http://localhost:4000/*"
      ],
      "js": ["app_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_flag.js"],
      "matches": [
        "http://127.0.0.1:4000/*",
        "http://localhost:4000/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
