{
  "manifest_version": 3,
  "name": "DNC Watchdog Helper",
  "version": "1.3.0",
  "description": "Fills Odyssey eFileCA from a DNC Watchdog case (stops before submit) and sends USPS tracking pages back to the local app.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://tools.usps.com/*",
    "https://www.usps.com/*",
    "https://california.tylertech.cloud/*",
    "https://california.tylerhost.net/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://tools.usps.com/*",
        "https://www.usps.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://california.tylertech.cloud/*",
        "https://california.tylerhost.net/*"
      ],
      "js": ["efile_fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["app_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_flag.js"],
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ]
}
