<.flash_group flash={@flash} />
<div class="mx-auto max-w-4xl px-4 py-12">
  <h1 class="text-3xl font-semibold text-zinc-900">Do Not Call Enforcement</h1>
  <p class="mt-2 text-zinc-600">
    Manage unsolicited contact evidence, case workflows, and demand-letter drafts.
  </p>

  <div class="mt-8 rounded-xl border border-zinc-200 p-6">
    <h2 class="text-lg font-semibold text-zinc-900">Start Here</h2>
    <p class="mt-2 text-sm text-zinc-600">
      Import communications with mix tasks, then review and advance each case through your workflow.
    </p>
    <div class="mt-4 flex gap-3">
      <.link navigate={~p"/communications"} class="rounded-md bg-zinc-900 px-4 py-2 text-sm text-white hover:bg-zinc-700">
        View imported messages
      </.link>
      <.link navigate={~p"/cases"} class="rounded-md bg-zinc-100 px-4 py-2 text-sm text-zinc-900 hover:bg-zinc-200">
        Open cases
      </.link>
    </div>
  </div>
</div>
