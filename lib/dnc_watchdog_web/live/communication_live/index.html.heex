<.header>
  Messages & Calls
  <:subtitle>
    {@filtered_count} shown of {@total_count} total · {Damages.format(
      Damages.total(@communications)
    )} trial damages · Last sync: {last_sync_label(@local_sync_state)}
  </:subtitle>
  <:actions>
    <form
      id="sync-lookback-form"
      phx-change="set_sync_options"
      phx-submit="sync_local"
      class="flex flex-wrap items-center gap-2"
    >
      <label for="sync-lookback-days" class="sr-only">Sync lookback</label>
      <select
        id="sync-lookback-days"
        name="lookback_days"
        class="rounded-lg border-slate-300 py-1.5 pl-2 pr-8 text-sm focus:border-indigo-500 focus:ring-indigo-500"
      >
        <option value="" selected={is_nil(@sync_lookback_days)}>Since last sync</option>
        <option value="7" selected={@sync_lookback_days == 7}>Last 7 days</option>
        <option value="14" selected={@sync_lookback_days == 14}>Last 14 days</option>
        <option value="30" selected={@sync_lookback_days == 30}>Last 30 days</option>
        <option value="90" selected={@sync_lookback_days == 90}>Last 90 days</option>
      </select>
      <label class="filter-checkbox">
        <input type="hidden" name="include_contacts" value="false" />
        <input
          type="checkbox"
          name="include_contacts"
          value="true"
          checked={@sync_include_contacts}
        /> Include contacts
      </label>
      <.button type="submit" phx-disable-with="Syncing…" disabled={@local_syncing}>
        {if @local_syncing, do: "Syncing…", else: "Sync from Mac"}
      </.button>
      <.button
        type="button"
        class="btn-secondary-sm"
        phx-click="probe_call_history"
        phx-value-phone={@search_query}
        disabled={@local_syncing}
      >
        Probe Call History
      </.button>
    </form>
    <.link navigate={~p"/cases"} class="btn-secondary-sm inline-flex items-center">
      View cases
    </.link>
  </:actions>
</.header>

<div class="space-y-3">
  <.display_filter_form
    id="display-filters"
    violations_only={@violations_only}
    hide_excluded={@hide_excluded}
    hide_spam={@hide_spam}
    hide_contacts={@hide_contacts}
    group_by_sender={@group_by_sender}
    workflow_phase={@workflow_phase}
    show_workflow={true}
    min_comms={@min_comms}
  />
  <.list_search_form
    id="communications-search"
    query={@search_query}
    placeholder="Phone, message text, company, case #…"
  />
</div>

<%= if @communications == [] do %>
  <div class="empty-state mt-4 px-4 py-8">
    <p class="font-medium text-slate-900">No messages or calls match the current filters.</p>
    <p class="mt-1 text-slate-500">
      Click <strong>Sync from Mac</strong>
      or adjust filters above, then click <strong>Apply filters</strong>.
    </p>
  </div>
<% else %>
  <%= if @group_by_sender do %>
    <div class="inbox-shell">
      <.inbox_thread_list
        groups={@communication_groups}
        selected_peer={@selected_peer}
        group_title_fn={&group_title/1}
        sort_by={@sort_by}
        sort_dir={@sort_dir}
      />
      <%= if @selected_group do %>
        <.inbox_thread_detail group={@selected_group} group_title_fn={&group_title/1} />
      <% else %>
        <div class="inbox-empty-detail">Select a sender to review messages.</div>
      <% end %>
    </div>
  <% else %>
    <.communication_rows_table
      communications={@communications}
      id_prefix="flat"
      compact
      class="mt-4 table-compact"
      sort_by={@sort_by}
      sort_dir={@sort_dir}
    />
  <% end %>
<% end %>
