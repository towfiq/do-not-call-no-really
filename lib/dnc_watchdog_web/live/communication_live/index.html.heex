<.header>
  Messages & Calls
  <:subtitle>
    {@filtered_count} shown of {@total_count} total · Last sync: {last_sync_label(
      @local_sync_state
    )}
  </:subtitle>
  <:actions>
    <.button
      type="button"
      phx-click="sync_local"
      phx-disable-with="Syncing…"
      disabled={@local_syncing}
    >
      {if @local_syncing, do: "Syncing…", else: "Sync from Mac"}
    </.button>
    <.link navigate={~p"/cases"} class="btn-secondary-sm inline-flex items-center">
      View cases
    </.link>
  </:actions>
</.header>

<div class="mt-4 space-y-3">
  <.display_filter_form
    id="display-filters"
    violations_only={@violations_only}
    hide_excluded={@hide_excluded}
    hide_spam={@hide_spam}
    group_by_sender={@group_by_sender}
    workflow_phase={@workflow_phase}
    show_workflow={true}
  />
  <.list_search_form
    id="communications-search"
    query={@search_query}
    placeholder="Phone, message text, company, case #…"
  />
</div>

<%= if @communications == [] do %>
  <div class="mt-4 rounded-lg border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm text-zinc-700">
    <p class="font-medium">No messages or calls match the current filters.</p>
    <p class="mt-1 text-zinc-600">
      Click <strong>Sync from Mac</strong>
      or adjust filters above, then click <strong>Apply filters</strong>.
    </p>
  </div>
<% else %>
  <%= if @group_by_sender do %>
    <div class="mt-4 space-y-3">
      <%= for group <- @communication_groups do %>
        <section id={"sender-#{group.peer}"} class="panel">
          <div class="panel-header">
            <div class="min-w-0">
              <h2 class="text-sm font-semibold text-zinc-900">{group_title(group)}</h2>
              <p class="text-xs text-zinc-500">
                {group.label} · {length(group.communications)} · latest {format_timestamp(
                  group.latest.timestamp
                )}
              </p>
            </div>
            <%= if group.latest.case do %>
              <.link
                navigate={~p"/cases/#{group.latest.case}"}
                class="text-xs font-medium text-brand hover:underline"
              >
                {DncWatchdog.Enforcement.Case.display_name(group.latest.case)}
              </.link>
            <% end %>
          </div>
          <.communication_rows_table
            communications={group.communications}
            id_prefix={"group-#{group.peer}"}
            compact
          />
        </section>
      <% end %>
    </div>
  <% else %>
    <.communication_rows_table
      communications={@communications}
      id_prefix="flat"
      compact
      class="mt-4 table-compact"
    />
  <% end %>
<% end %>
