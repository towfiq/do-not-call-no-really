<.header>
  Listing Cases
  <:subtitle>
    {@filtered_count} shown of {@total_count} with at least one violation.
  </:subtitle>
  <:actions>
    <.link patch={~p"/cases/new"}>
      <.button>New Case</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-4">
  <.workflow_phase_filters workflow_phase={@workflow_phase} />
  <.list_search_form
    id="cases-search"
    query={@search_query}
    placeholder="Company, phone, notes, case #, status…"
  />
</div>

<.table
  id="cases"
  rows={@streams.cases}
  row_click={fn {_id, case} -> JS.navigate(~p"/cases/#{case}") end}
>
  <:col :let={{_id, case}} label="Company name">{case.company_name}</:col>
  <:col :let={{_id, case}} label="Communications">{length(case.communications)}</:col>
  <:col :let={{_id, case}} label="Status">{case.status}</:col>
  <:col :let={{_id, case}} label="Workflow step">{case.workflow_step}</:col>
  <:col :let={{_id, case}} label="Mail">
    <%= if case.mail_tracking_number not in [nil, ""] do %>
      <.mail_delivery_badge status={case.mail_delivery_status || "pending"} />
    <% else %>
      <span class="text-zinc-400">—</span>
    <% end %>
  </:col>
  <:col :let={{_id, case}} label="Notes">{case.notes}</:col>
  <:col :let={{_id, case}} label="Letter draft">{case.letter_draft}</:col>
  <:action :let={{_id, case}}>
    <div class="sr-only">
      <.link navigate={~p"/cases/#{case}"}>Show</.link>
    </div>
    <.link patch={~p"/cases/#{case}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, case}}>
    <.link
      phx-click={JS.push("delete", value: %{id: case.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action in [:new, :edit]} id="case-modal" show on_cancel={JS.patch(@index_path)}>
  <.live_component
    module={DncWatchdogWeb.CaseLive.FormComponent}
    id={@case.id || :new}
    title={@page_title}
    action={@live_action}
    case={@case}
    patch={@index_path}
  />
</.modal>
