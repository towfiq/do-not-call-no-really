<.header>
  Cases
  <:subtitle>
    <%= if @search_query != "" do %>
      {@filtered_count} matching “{@search_query}” · {Damages.format(@damages_total)} trial damages
    <% else %>
      {@filtered_count} shown of {@total_count} with at least one violation · {Damages.format(
        @damages_total
      )} trial damages
    <% end %>
  </:subtitle>
  <:actions>
    <.link patch={~p"/cases/new"}>
      <.button>New Case</.button>
    </.link>
  </:actions>
</.header>

<div class="command-bar">
  <div class="command-bar-row">
    <.list_search_form
      id="cases-search"
      query={@search_query}
      placeholder="Search company, phone, message, notes, or case number"
    />
    <.min_communications_filter min_comms={@min_comms} />
  </div>
  <.workflow_phase_filters workflow_phase={@workflow_phase} />
</div>

<.table
  id="cases"
  rows={@streams.cases}
  row_click={fn {_id, case} -> JS.navigate(~p"/cases/#{case}") end}
  sort_by={@sort_by}
  sort_dir={@sort_dir}
  footer_cells={[
    "Total",
    @communications_total,
    Damages.format(@damages_total),
    "",
    "",
    ""
  ]}
>
  <:col :let={{_id, case}} label="Defendant">
    {DncWatchdog.Enforcement.Case.display_name(case)}
  </:col>
  <:col :let={{_id, case}} label="Communications" sort_key="communications">
    {length(case.communications)}
  </:col>
  <:col :let={{_id, case}} label="Damages">{Damages.format(Damages.for_case(case))}</:col>
  <:col :let={{_id, case}} label="Status">
    <span class="status-pill">{case.status}</span>
  </:col>
  <:col :let={{_id, case}} label="Workflow step">
    <span class="capitalize">{String.replace(case.workflow_step || "", "_", " ")}</span>
  </:col>
  <:col :let={{_id, case}} label="Mail">
    <%= if case.mail_tracking_number not in [nil, ""] do %>
      <.mail_delivery_badge status={case.mail_delivery_status || "pending"} />
    <% else %>
      <span class="text-zinc-400">—</span>
    <% end %>
  </:col>
  <:action :let={{_id, case}}>
    <div class="sr-only">
      <.link navigate={~p"/cases/#{case}"}>Show</.link>
    </div>
    <.link patch={~p"/cases/#{case}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, case}}>
    <.link
      phx-click={JS.push("delete", value: %{id: case.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal :if={@live_action in [:new, :edit]} id="case-modal" show on_cancel={JS.patch(@index_path)}>
  <.live_component
    module={DncWatchdogWeb.CaseLive.FormComponent}
    id={@case.id || :new}
    title={@page_title}
    action={@live_action}
    case={@case}
    patch={@index_path}
  />
</.modal>
