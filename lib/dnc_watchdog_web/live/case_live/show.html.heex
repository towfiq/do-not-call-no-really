<.header>
  Case {@case.id}
  <:subtitle>Track violations, evidence, legal entity, and letter workflow.</:subtitle>
  <:actions>
    <.button :if={@case.workflow_step != "settled"} phx-click="advance_workflow">
      Advance workflow
    </.button>
    <.button
      :if={@case.workflow_step != "settled"}
      phx-click="mark_settled"
      data-confirm="Mark this case as settled? Use this when the defendant paid before trial."
    >
      Mark as settled
    </.button>
    <.button phx-click="generate_letter">Generate letter draft</.button>
    <.button phx-click="generate_court_filing">Generate small claims filing</.button>
    <.button phx-click="generate_civil_complaint">Generate civil complaint</.button>
    <.link patch={~p"/cases/#{@case}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit case</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-4 grid gap-4 lg:grid-cols-2">
  <.list>
    <:item title="Defendant">{DncWatchdog.Enforcement.Case.display_name(@case)}</:item>
    <:item
      :if={DncWatchdog.Enforcement.Case.display_name(@case) != @case.company_name}
      title="Import label"
    >
      {@case.company_name}
    </:item>
    <:item title="Status">{@case.status}</:item>
    <:item title="Workflow step">{@case.workflow_step}</:item>
    <:item title="Claimant">{@case.claimant_name || "—"} ({@case.claimant_phone || "—"})</:item>
    <:item title="Claimant address">{@case.claimant_address || "—"}</:item>
    <:item title="Claimant email">{@case.claimant_email || "—"}</:item>
    <:item title="DNC registration date">{@case.dnc_registration_date || "—"}</:item>
    <:item title="STOP contact date">{@case.stop_contact_date || "—"}</:item>
    <:item title="Small claims county">{@case.small_claims_county || "—"}</:item>
    <:item title="Settlement offer">{@case.settlement_amount || "Full statutory total"}</:item>
    <:item title="Relief per violation">
      {@case.relief_amount_per_violation || "500.00 (default)"}
    </:item>
    <:item title="Notes">{@case.notes}</:item>
  </.list>

  <div class="content-card">
    <div class="content-card-header">
      <h3 class="content-card-title">Workflow checklist</h3>
    </div>
    <div class="content-card-body">
      <ul class="space-y-2 text-sm">
        <%= for req <- @requirements do %>
          <li class="flex items-start gap-2.5">
            <span class={[
              "mt-1 inline-block h-2 w-2 rounded-full",
              req.met && "bg-emerald-500",
              !req.met && "bg-amber-400"
            ]} />
            <span>
              <span class="font-medium text-slate-900">{req.label}</span>
              <span class="text-slate-500">{" — "}{req.detail}</span>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

<div class="mt-8">
  <.live_component
    module={DncWatchdogWeb.CaseLive.LegalEntityFormComponent}
    id={"legal-entity-#{@case.id}"}
    case={@case}
  />
</div>

<div class="mt-8 rounded-lg border border-zinc-200 p-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold">Evidence attachments</h3>
      <p class="text-sm text-zinc-600">Upload screenshots to attach as exhibits in the letter.</p>
    </div>
  </div>

  <form
    id="evidence-upload-form"
    phx-submit="upload_evidence"
    phx-change="validate_evidence"
    class="mt-4"
  >
    <.live_file_input upload={@uploads.evidence} class="text-sm" />
    <.button type="submit" class="mt-2" phx-disable-with="Uploading...">
      Upload selected files
    </.button>
  </form>

  <%= for entry <- @uploads.evidence.entries do %>
    <p class="mt-2 text-xs text-zinc-500">{entry.client_name} — {entry.progress}%</p>
  <% end %>

  <%= if @attachments == [] do %>
    <p class="mt-4 text-sm text-zinc-600">No attachments yet.</p>
  <% else %>
    <ul class="mt-4 space-y-2">
      <%= for att <- @attachments do %>
        <li class="flex items-center justify-between rounded border border-zinc-100 px-3 py-2 text-sm">
          <div>
            <a
              href={attachment_url(att)}
              target="_blank"
              class="font-medium text-brand hover:underline"
            >
              {att.filename}
            </a>
            <%= if att.caption do %>
              <span class="text-zinc-500">{" — "}{att.caption}</span>
            <% end %>
          </div>
          <button
            type="button"
            phx-click="delete_attachment"
            phx-value-id={att.id}
            class="text-xs font-semibold text-rose-700 hover:underline"
          >
            Remove
          </button>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<div class="mt-8 rounded-lg border border-zinc-200 p-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold">Letter draft</h3>
      <p class="mt-1 text-sm text-zinc-600">
        Generate from violations and evidence, then edit before sending certified mail.
      </p>
    </div>
    <%= if @case.letter_draft not in [nil, ""] do %>
      <.link href={~p"/cases/#{@case}/letter.pdf"} class="inline-flex">
        <.button type="button">Download PDF with exhibits</.button>
      </.link>
    <% end %>
  </div>

  <form id="letter-draft-form" phx-submit="save_letter_draft" class="mt-4 space-y-3">
    <div>
      <label for="letter_draft_body" class="block text-sm font-medium text-zinc-700">
        Draft text
      </label>
      <textarea
        name="letter_draft[body]"
        id="letter_draft_body"
        rows="20"
        placeholder="Click Generate letter draft above, or type your demand letter here."
        class="mt-1 block w-full rounded-lg border-zinc-300 font-mono text-xs shadow-sm focus:border-brand focus:ring-brand"
      >{@case.letter_draft || ""}</textarea>
    </div>
    <.button type="submit" phx-disable-with="Saving...">Save letter draft</.button>
  </form>
</div>

<div class="mt-8 rounded-lg border border-zinc-200 p-4">
  <h3 class="text-base font-semibold">Filing limits &amp; venue</h3>
  <p class="mt-1 text-sm text-zinc-600">
    California rules: $12,500 small-claims cap, and at most 2 small-claims cases over $2,500 per calendar year (CCP § 116.231).
  </p>
  <%= if @filing_limits.violation_count == 0 do %>
    <p class="mt-3 text-sm text-zinc-600">Mark violations to see filing limits.</p>
  <% else %>
    <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-zinc-700">Violations / trial damages</dt>
        <dd class="text-zinc-600">
          {@filing_limits.violation_count} × $1,500 = {format_money_decimal(
            @filing_limits.total_damages
          )}
        </dd>
      </div>
      <div>
        <dt class="font-medium text-zinc-700">Small claims amount</dt>
        <dd class="text-zinc-600">
          {format_money_decimal(@filing_limits.small_claims_claim_amount)}
        </dd>
      </div>
      <div>
        <dt class="font-medium text-zinc-700">Recommended venue</dt>
        <dd class="text-zinc-600">{@filing_limits.recommended_venue_label}</dd>
      </div>
      <div>
        <dt class="font-medium text-zinc-700">
          Small claims &gt;$2,500 slots ({@filing_limits.calendar_year})
        </dt>
        <dd class="text-zinc-600">
          {@filing_limits.small_claims_high_filings_this_year} used, {@filing_limits.small_claims_high_filings_remaining} remaining
        </dd>
      </div>
    </dl>
    <%= if @filing_limits.warnings != [] do %>
      <ul class="mt-4 space-y-2 text-sm text-amber-800">
        <%= for warning <- @filing_limits.warnings do %>
          <li class="rounded border border-amber-200 bg-amber-50 px-3 py-2">{warning}</li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>

<div class="mt-8">
  <h3 class="text-base font-semibold">Small-claims filing draft (Santa Clara County)</h3>
  <p class="mt-1 text-sm text-zinc-600">
    Generates an SC-100 worksheet, statement of facts, declaration, damages worksheet, and exhibit index.
    Review before filing — not legal advice.
  </p>
  <%= if @case.court_filing_draft in [nil, ""] do %>
    <p class="mt-2 text-sm text-zinc-600">
      Mark violations and add the defendant's legal entity address, then click <strong>Generate small claims filing</strong>.
    </p>
  <% else %>
    <div class="mt-3 flex flex-wrap gap-2">
      <.link href={~p"/cases/#{@case}/court_filing.pdf"} class="inline-flex">
        <.button>Download small claims PDF with exhibits</.button>
      </.link>
    </div>
    <pre class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap rounded-lg border border-zinc-200 bg-zinc-50 p-4 text-xs">{@case.court_filing_draft}</pre>
  <% end %>
</div>

<div class="mt-8">
  <h3 class="text-base font-semibold">Civil complaint draft (Santa Clara County)</h3>
  <p class="mt-1 text-sm text-zinc-600">
    For limited or unlimited civil court when damages exceed small-claims limits or annual filing slots are used.
  </p>
  <%= if @case.civil_complaint_draft in [nil, ""] do %>
    <p class="mt-2 text-sm text-zinc-600">
      Click <strong>Generate civil complaint</strong> when recommended venue is civil court.
    </p>
  <% else %>
    <div class="mt-3 flex flex-wrap gap-2">
      <.link href={~p"/cases/#{@case}/civil_complaint.pdf"} class="inline-flex">
        <.button>Download civil complaint PDF with exhibits</.button>
      </.link>
    </div>
    <pre class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap rounded-lg border border-zinc-200 bg-zinc-50 p-4 text-xs">{@case.civil_complaint_draft}</pre>
  <% end %>
</div>

<div class="mt-8 rounded-lg border border-zinc-200 p-4">
  <h3 class="text-base font-semibold">Record court filing</h3>
  <p class="mt-1 text-sm text-zinc-600">
    After you file, record the date, venue, and amount claimed. This tracks your annual small-claims limit.
  </p>
  <form
    id="court-filing-form"
    phx-submit="save_court_filing"
    class="mt-4 grid gap-3 sm:grid-cols-2"
  >
    <div>
      <label for="court_filing_filed_at" class="block text-sm font-medium text-zinc-700">
        Filing date
      </label>
      <input
        type="date"
        name="court_filing[filed_at]"
        id="court_filing_filed_at"
        value={@case.court_filed_at || ""}
        class="mt-1 block w-full rounded-lg border-zinc-300 text-sm shadow-sm focus:border-brand focus:ring-brand"
      />
    </div>
    <div>
      <label for="court_filing_venue" class="block text-sm font-medium text-zinc-700">
        Venue
      </label>
      <select
        name="court_filing[venue]"
        id="court_filing_venue"
        class="mt-1 block w-full rounded-lg border-zinc-300 text-sm shadow-sm focus:border-brand focus:ring-brand"
      >
        <option value="">Select venue…</option>
        <%= for venue <- @court_filed_venues do %>
          <option value={venue} selected={@case.court_filed_venue == venue}>
            {court_filed_venue_label(venue)}
          </option>
        <% end %>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="court_filing_amount" class="block text-sm font-medium text-zinc-700">
        Amount claimed
      </label>
      <input
        type="number"
        name="court_filing[amount]"
        id="court_filing_amount"
        value={court_filed_amount_value(@case)}
        step="0.01"
        min="0"
        class="mt-1 block w-full rounded-lg border-zinc-300 text-sm shadow-sm focus:border-brand focus:ring-brand"
      />
    </div>
    <div class="sm:col-span-2">
      <.button type="submit">Save court filing record</.button>
    </div>
  </form>
</div>

<div
  id="mail-tracking-section"
  phx-hook="UspsHelper"
  class="mt-8 rounded-lg border border-zinc-200 p-4"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold">Certified mail tracking</h3>
      <p class="mt-1 text-sm text-zinc-600">
        Save the USPS tracking number after you mail the demand letter.
        Refresh status opens USPS.com in your real browser and waits for the Chrome or Safari helper
        to send the hydrated tracking page back. Headless Chrome often gets an empty shell
        that never finishes loading.
        <%= unless @usps_tracking_configured do %>
          Install Google Chrome or Chromium for PDF export and optional headless fallback.
        <% end %>
      </p>
      <p :if={@usps_helper_available} class="mt-1 text-sm font-medium text-emerald-700">
        Browser helper connected
      </p>
    </div>
    <%= if @case.mail_tracking_number not in [nil, ""] do %>
      <.mail_delivery_badge status={@case.mail_delivery_status || "pending"} />
    <% end %>
  </div>

  <form
    id="mail-tracking-form"
    phx-submit="save_mail_tracking"
    class="mt-4 flex flex-wrap items-end gap-3"
  >
    <div class="min-w-[16rem] flex-1">
      <label for="mail_tracking_tracking_number" class="block text-sm font-medium text-zinc-700">
        Tracking number
      </label>
      <input
        type="text"
        name="mail_tracking[tracking_number]"
        id="mail_tracking_tracking_number"
        value={@case.mail_tracking_number || ""}
        placeholder="9400 1118 9922 3197 4284 90"
        class="mt-1 block w-full rounded-lg border-zinc-300 text-sm shadow-sm focus:border-brand focus:ring-brand"
      />
    </div>
    <.button type="submit">Save tracking number</.button>
    <%= if @case.mail_tracking_number not in [nil, ""] do %>
      <.button
        id="refresh-mail-tracking-button"
        type="button"
        phx-click="refresh_mail_tracking"
        phx-disable-with="Checking..."
        disabled={@mail_tracking_refreshing}
      >
        {if @mail_tracking_refreshing, do: "Checking USPS…", else: "Refresh status"}
      </.button>
      <.link
        href={mail_tracking_url(@case.mail_tracking_number)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex"
      >
        <.button type="button">View on USPS.com</.button>
      </.link>
    <% end %>
  </form>

  <.mail_tracking_progress_dialog
    :if={@mail_tracking_progress}
    progress={@mail_tracking_progress}
  />

  <%= if @case.mail_tracking_number not in [nil, ""] do %>
    <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-zinc-700">Last checked</dt>
        <dd class="text-zinc-600">{format_checked_at(@case.mail_tracking_checked_at)}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-medium text-zinc-700">Latest status</dt>
        <dd class="text-zinc-600">
          {@case.mail_tracking_summary || "Not checked yet — click Refresh status"}
        </dd>
      </div>
    </dl>
  <% end %>
</div>

<div class="mt-8 rounded-lg border border-zinc-200 p-4">
  <h3 class="text-base font-semibold">Linked cases</h3>
  <p class="mt-1 text-sm text-zinc-600">
    Group cases that share the same caller but use different phone numbers. Communications from all linked cases appear below.
  </p>

  <%= if @linked_cases == [] do %>
    <p class="mt-3 text-sm text-zinc-600">No linked cases yet.</p>
  <% else %>
    <ul class="mt-3 space-y-2">
      <%= for linked <- @linked_cases do %>
        <li class="flex flex-wrap items-center justify-between gap-2 rounded border border-zinc-100 px-3 py-2 text-sm">
          <div>
            <.link navigate={~p"/cases/#{linked}"} class="font-medium text-brand hover:underline">
              {DncWatchdog.Enforcement.Case.display_name(linked)}
            </.link>
            <span class="text-zinc-500"> — case #{linked.id}</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              phx-click="merge_case"
              phx-value-id={linked.id}
              data-confirm={"Merge case #{linked.id} into this case? All messages and calls from that sender (even if imported under another case) will move here and case #{linked.id} will be deleted."}
              class="text-xs font-semibold text-brand hover:underline"
            >
              Merge into this case
            </button>
            <button
              type="button"
              phx-click="unlink_case"
              phx-value-id={linked.id}
              class="text-xs font-semibold text-zinc-600 hover:underline"
            >
              Unlink
            </button>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <.link_case_typeahead query={@link_case_query} results={@link_case_results} />
</div>

<div class="mt-6">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="text-base font-semibold text-zinc-900">Related communications</h2>
      <%= if @linked_cases != [] do %>
        <p class="text-xs text-zinc-500">Includes {length(@linked_cases) + 1} linked case(s)</p>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <.display_filter_form
      id="case-display-filters"
      violations_only={@violations_only}
      hide_excluded={@hide_excluded}
      hide_contacts={@hide_contacts}
      show_group_by={false}
      show_spam={false}
    />
  </div>

  <%= if @communications == [] do %>
    <p class="mt-3 text-sm text-zinc-600">
      No communications match the current filters. Adjust filters above and click Apply filters.
    </p>
  <% else %>
    <.communication_rows_table
      communications={@communications}
      id_prefix={"case-#{@case.id}"}
      compact
      class="mt-3 table-compact"
    />
  <% end %>
</div>

<.back navigate={~p"/cases"}>Back to cases</.back>

<.modal :if={@live_action == :edit} id="case-modal" show on_cancel={JS.patch(~p"/cases/#{@case}")}>
  <.live_component
    module={DncWatchdogWeb.CaseLive.FormComponent}
    id={@case.id}
    title={@page_title}
    action={@live_action}
    case={@case}
    patch={~p"/cases/#{@case}"}
  />
</.modal>
