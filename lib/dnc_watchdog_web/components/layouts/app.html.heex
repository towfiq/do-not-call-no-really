<header class="border-b border-zinc-200 bg-white px-4 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-7xl items-center justify-between py-2.5 text-sm">
    <a href={~p"/"} class="font-semibold text-zinc-900">
      DNC Watchdog
    </a>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-zinc-600">
      <.link navigate={~p"/"} class="hover:text-zinc-900">Home</.link>
      <.link navigate={~p"/communications"} class="hover:text-zinc-900">Messages</.link>
      <.link navigate={~p"/excluded-senders"} class="hover:text-zinc-900">Excluded senders</.link>
      <.link navigate={~p"/cases"} class="hover:text-zinc-900">Cases</.link>
      <.link navigate={~p"/settings"} class="hover:text-zinc-900">Profile</.link>
    </nav>
  </div>
</header>
<main class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
