<% current_path = assigns[:current_path] || "/" %>
<div class="app-shell">
  <aside class="app-sidebar">
    <div class="app-sidebar-brand">
      <div class="app-sidebar-brand-mark">DNC</div>
      <span class="app-sidebar-brand-text">Watchdog</span>
    </div>

    <nav class="app-sidebar-nav" aria-label="Main">
      <.sidebar_link navigate={~p"/"} current_path={current_path} icon="hero-home">
        Dashboard
      </.sidebar_link>
      <.sidebar_link navigate={~p"/communications"} current_path={current_path} icon="hero-inbox">
        Messages
      </.sidebar_link>
      <.sidebar_link navigate={~p"/cases"} current_path={current_path} icon="hero-briefcase">
        Cases
      </.sidebar_link>
      <.sidebar_link
        navigate={~p"/excluded-senders"}
        current_path={current_path}
        icon="hero-no-symbol"
      >
        Excluded senders
      </.sidebar_link>
    </nav>

    <div class="app-sidebar-footer">
      <.sidebar_link navigate={~p"/settings"} current_path={current_path} icon="hero-user-circle">
        Profile & settings
      </.sidebar_link>
    </div>
  </aside>

  <div class="app-main">
    <header class="app-topbar">
      <span class="text-sm font-semibold text-slate-900">DNC Watchdog</span>
      <nav class="flex gap-3 text-xs font-medium text-slate-600">
        <.link navigate={~p"/communications"}>Messages</.link>
        <.link navigate={~p"/cases"}>Cases</.link>
      </nav>
    </header>

    <main class="app-content">
      <div class="app-content-inner">
        <.flash_group flash={@flash} />
        {@inner_content}
      </div>
    </main>
  </div>
</div>
