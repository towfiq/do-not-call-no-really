<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href={~p"/"} class="font-semibold text-zinc-900">
        DNC Watchdog
      </a>
    </div>
    <nav class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <.link navigate={~p"/"} class="hover:text-zinc-700">Home</.link>
      <.link navigate={~p"/communications"} class="hover:text-zinc-700">Messages</.link>
      <.link navigate={~p"/excluded-senders"} class="hover:text-zinc-700">Excluded senders</.link>
      <.link navigate={~p"/cases"} class="hover:text-zinc-700">Cases</.link>
      <.link navigate={~p"/settings"} class="hover:text-zinc-700">Your profile</.link>
    </nav>
  </div>
</header>
<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
